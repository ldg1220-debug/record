ANTHROPIC_API_KEY=your_anthropic_api_key_here
PORT=8080

# 앱↔서버 공유 시크릿 (랜덤 문자열 32자 이상 권장)
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=your_random_secret_token_here

# 웹 프론트 도메인 (쉼표 구분, 미설정 시 전체 허용)
# 예) ALLOWED_ORIGINS=https://your-frontend.vercel.app
ALLOWED_ORIGINS=
